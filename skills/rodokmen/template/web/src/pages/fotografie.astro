---
// /fotografie/ – všechny rodinné fotografie a dokumenty (data/dokumenty.json), seřazené podle osoby (fotky jedné osoby jsou vedle sebe).
// Skupina = „kdo“ (příbuzný bez vlastní stránky), jinak předek z „osoby“; pořadí podle čísla předka (Kekulé), pak jména.
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { docs, people } from '../lib/data.js';
const groups = new Map();
for (const d of docs) {
  const anc = d.people?.[0] ? people[d.people[0]] : null;
  const key = d.who || anc?.slug || d.img;
  if (!groups.has(key)) groups.set(key, { who: d.who, anc, items: [] });
  groups.get(key).items.push(d);
}
// Pořadí: po manželských párech předků (Kekulé 2n a 2n+1 vedle sebe, výchozí osoba první), po předcích jejich
// příbuzní (děti, snachy, potomci – „kdo“), pak další pár; v rámci páru muž, žena, pak příbuzní podle roku narození.
const born = (g) => +((g.items[0]?.caption || '').match(/^[^(,–]*\((?:\* )?(\d{4})/)?.[1] ?? 9999);   // rok narození z popisku
const pair = (k) => (k == null ? 1e9 : k === 1 ? 1 : k - (k % 2));
const list = [...groups.values()].sort((a, b) =>
  pair(a.anc?.k) - pair(b.anc?.k) || (a.who ? 1 : 0) - (b.who ? 1 : 0) || (a.anc?.k ?? 0) - (b.anc?.k ?? 0) ||
  born(a) - born(b) || (a.who || '').localeCompare(b.who || '', 'cs'));
---
<Base title="Fotografie" wide>
  <h1>Rodinné fotografie a dokumenty</h1>
  <p class="lead">Fotografie předků a jejich příbuzných a rodinné dokumenty, seskupené podle osoby. Kliknutím obrázek zvětšíte. Snímky zápisů z matrik najdete na stránce <a href="/zapisy/">Zápisy</a>.</p>
  {list.length ? (
    <div class="docs">
      {list.flatMap((g) => g.items.map((d, i) => (
        <figure class={i === 0 ? 'group-start' : ''}>
          <div class="who">{g.who ? g.who : g.anc ? <PersonLink slug={g.anc.slug} showYears={false} /> : ' '}{g.who && g.anc && <span class="small muted"> · u předka <PersonLink slug={g.anc.slug} showYears={false} /></span>}</div>
          <a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a>
          <figcaption>{d.caption}</figcaption>
        </figure>
      )))}
    </div>
  ) : <p class="muted">Zatím tu nic není.</p>}
</Base>
